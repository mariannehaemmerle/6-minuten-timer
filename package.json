{
  "name": "instagram-freebie-bot",
  "version": "1.0.0",
  "description": "Instagram Automatisierung mit Double Opt-In für Freebies",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node backend/server.js",
